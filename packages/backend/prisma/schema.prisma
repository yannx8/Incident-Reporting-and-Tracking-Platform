generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum IncidentStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AssignmentStatus {
  PENDING_ACCEPTANCE
  ACCEPTED
  REASSIGNMENT_REQUESTED
  CLOSED
}

enum ProgressType {
  STARTED
  ON_SITE
  BLOCKED
  UPDATE
}

enum UserRole {
  USER
  RESPONSABLE
  ADMINISTRATOR
}

model Organization {
  id          String                   @id @default(uuid()) @db.Uuid
  name        String
  slug        String                   @unique
  createdAt   DateTime                 @default(now())
  sites       Site[]
  memberships OrganizationMembership[]
  incidents   Incident[]
  responsables ResponsableProfile[]
  specialties Specialty[]
  sessions    Session[]
}

model User {
  id                  String                   @id @default(uuid()) @db.Uuid
  name                String
  email               String                   @unique
  passwordHash        String
  isVerified          Boolean                  @default(false)
  verificationToken   String?
  verificationExpiry  DateTime?
  resetToken          String?
  resetExpiry         DateTime?
  createdAt           DateTime                 @default(now())
  memberships         OrganizationMembership[]
  reportedIncidents   Incident[]               @relation("Reporter")
  auditEvents         AuditEvent[]
  comments            Comment[]
  progressUpdates     ProgressUpdate[]
  responsableProfiles ResponsableProfile[]
  sessions            Session[]
}

model Session {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  organizationId String       @db.Uuid
  tokenHash      String       @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  lastUsedAt     DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([organizationId, revokedAt])
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  roles          UserRole[]
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, status])
}

model Site {
  id               String            @id @default(uuid()) @db.Uuid
  organizationId   String            @db.Uuid
  name             String
  address          String?
  latitude         Float
  longitude        Float
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incidents        Incident[]
  responsableSites ResponsableSite[]

  @@index([organizationId, isActive])
}

model ResponsableProfile {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @db.Uuid
  userId         String                 @db.Uuid
  isActive       Boolean                @default(true)
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialties    ResponsableSpecialty[]
  sites          ResponsableSite[]
  assignments    Assignment[]

  @@unique([organizationId, userId])
}

model Specialty {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @db.Uuid
  name           String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  responsables   ResponsableSpecialty[]

  @@unique([organizationId, name])
}

model ResponsableSpecialty {
  responsableProfileId String             @db.Uuid
  specialtyId          String             @db.Uuid
  responsable          ResponsableProfile @relation(fields: [responsableProfileId], references: [id], onDelete: Cascade)
  specialty            Specialty          @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([responsableProfileId, specialtyId])
}

model ResponsableSite {
  responsableProfileId String             @db.Uuid
  siteId               String             @db.Uuid
  isActive             Boolean            @default(true)
  responsable          ResponsableProfile @relation(fields: [responsableProfileId], references: [id], onDelete: Cascade)
  site                 Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([responsableProfileId, siteId])
}

model Incident {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  siteId         String           @db.Uuid
  reporterId     String           @db.Uuid
  title          String
  description    String
  category       String
  priority       Priority
  latitude       Float
  longitude      Float
  status         IncidentStatus   @default(NEW)
  resolutionText String?
  version        Int              @default(1)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  verifiedAt     DateTime?
  organization   Organization     @relation(fields: [organizationId], references: [id])
  site           Site             @relation(fields: [siteId], references: [id])
  reporter       User             @relation("Reporter", fields: [reporterId], references: [id])
  assignments    Assignment[]
  progress       ProgressUpdate[]
  comments       Comment[]
  attachments    Attachment[]
  auditEvents    AuditEvent[]
  notifications  Notification[]

  @@index([organizationId, status, priority])
  @@index([siteId])
  @@index([reporterId])
}

model Assignment {
  id                   String             @id @default(uuid()) @db.Uuid
  incidentId           String             @db.Uuid
  responsableProfileId String             @db.Uuid
  assignedById         String             @db.Uuid
  status               AssignmentStatus   @default(PENDING_ACCEPTANCE)
  isActive             Boolean            @default(true)
  reassignReason       String?
  startedAt            DateTime           @default(now())
  endedAt              DateTime?
  incident             Incident           @relation(fields: [incidentId], references: [id])
  responsable          ResponsableProfile @relation(fields: [responsableProfileId], references: [id])

  @@index([incidentId, isActive])
  @@index([responsableProfileId])
}

model ProgressUpdate {
  id         String       @id @default(uuid()) @db.Uuid
  incidentId String       @db.Uuid
  authorId   String       @db.Uuid
  type       ProgressType
  note       String
  createdAt  DateTime     @default(now())
  incident   Incident     @relation(fields: [incidentId], references: [id])
  author     User         @relation(fields: [authorId], references: [id])

  @@index([incidentId, createdAt])
}

model Comment {
  id         String   @id @default(uuid()) @db.Uuid
  incidentId String   @db.Uuid
  authorId   String   @db.Uuid
  body       String
  createdAt  DateTime @default(now())
  incident   Incident @relation(fields: [incidentId], references: [id])
  author     User     @relation(fields: [authorId], references: [id])

  @@index([incidentId, createdAt])
}

model Attachment {
  id           String   @id @default(uuid()) @db.Uuid
  incidentId   String   @db.Uuid
  uploadedById String   @db.Uuid
  originalName String
  mimeType     String
  sizeBytes    Int
  storageRef   String
  createdAt    DateTime @default(now())
  incident     Incident @relation(fields: [incidentId], references: [id])

  @@index([incidentId])
}

model AuditEvent {
  id         String    @id @default(uuid()) @db.Uuid
  incidentId String?   @db.Uuid
  actorId    String    @db.Uuid
  eventType  String
  payload    Json
  createdAt  DateTime  @default(now())
  incident   Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  actor      User      @relation(fields: [actorId], references: [id])

  @@index([incidentId, createdAt])
  @@index([actorId])
}

model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  recipientId String    @db.Uuid
  eventType   String
  incidentId  String?   @db.Uuid
  title       String
  body        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  incident    Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  @@index([recipientId, readAt])
}
